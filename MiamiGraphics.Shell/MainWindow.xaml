<Window x:Class="MiamiGraphics.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiamiGraphics.Shell"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Miami Graphics"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized"
        Background="#FF000000"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="36"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0A0612" />

        <Grid x:Name="SplashOverlay"
              Panel.ZIndex="10"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                     RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Offset="0.0"  Color="#EB14081E"/>
                    <GradientStop Offset="0.7"  Color="#F70A0612"/>
                    <GradientStop Offset="1.0"  Color="#FF06030D"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Ellipse Width="380" Height="220" Fill="#4D8B24C8"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect>
                    <BlurEffect Radius="64"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1"
                                    CenterX="190" CenterY="110"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="HaloScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="0.94" To="1.08" Duration="0:0:1.6"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HaloScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="0.94" To="1.08" Duration="0:0:1.6"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,32"
                       Foreground="#66CB77EF"
                       FontFamily="Consolas"
                       FontSize="10"
                       Text="MIAMI GRAPHICS  ·  V1.0.16"/>
        </Grid>
    </Grid>
</Window>
